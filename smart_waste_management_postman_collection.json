    {
      "name": "5. User Management (Admin Only)",
      "item": [
        {
          "name": "List Users (Paginated)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data.length > 0) {",
                  "    pm.collectionVariables.set('user_uuid', jsonData.data[0].uuid);",
                  "    console.log('Saved user_uuid: ' + jsonData.data[0].uuid);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{admin_token}}", "type": "string" }]
            },
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/users?page=1&per_page=10&sort=created_at&order=desc",
              "host": ["{{base_url}}"],
              "path": ["users"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "per_page", "value": "10" },
                { "key": "sort", "value": "created_at" },
                { "key": "order", "value": "desc" },
                { "key": "search", "value": "", "disabled": true },
                { "key": "role", "value": "user", "disabled": true },
                { "key": "is_active", "value": "true", "disabled": true }
              ]
            },
            "description": "Daftar pengguna terpaginasi (Khusus Admin)."
          }
        },
        {
          "name": "Create User (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data.uuid) {",
                  "    pm.collectionVariables.set('user_uuid', jsonData.data.uuid);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{admin_token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Petugas Lapangan Alpha\",\n  \"email\": \"petugas.alpha@waste.local\",\n  \"password\": \"PetugasPass123!\",\n  \"role\": \"admin\",\n  \"is_active\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/users",
              "host": ["{{base_url}}"],
              "path": ["users"]
            },
            "description": "Menambahkan akun pengguna atau petugas baru."
          }
        },
